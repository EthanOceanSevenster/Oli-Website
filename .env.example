# Copy to .env.local for local work, and set the same keys in the Vercel
# dashboard under Settings → Environment Variables.

# ---------------------------------------------------------------- database --
# REQUIRED in production. Any Postgres works — Vercel Postgres, Neon, Supabase,
# RDS, or your own server. Use the POOLED connection string on serverless.
#
# Leave this empty for local development and the app falls back to PGlite:
# real Postgres compiled to WebAssembly, stored in .pglite/, no install needed.
# PGlite is single-process and local-only; the app refuses to start on Vercel
# without a real DATABASE_URL.
DATABASE_URL=

# Sockets held per serverless instance. Leave at 1 behind a pooler.
DATABASE_POOL_MAX=1

# Where the local PGlite database lives. Ignored when DATABASE_URL is set.
PGLITE_PATH=./.pglite

# ----------------------------------------------------------------- testing --
# Target for `npm run test:api`. Point it at a preview URL to check a deploy.
BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- payments --
# Payfast (payfast.io). Leave these unset and checkout falls back to the
# prototype's simulated card form, so the site still works.
#
# Get the first two from the Payfast dashboard under Settings → Integration.
# Set the passphrase there too, then copy it here EXACTLY — a trailing space
# is the usual cause of "Generated signature does not match".
#
# Keep the passphrase letters and digits only. Payfast's own PHP SDK encodes
# it twice when signing a checkout but once when checking a notification, so a
# passphrase containing symbols can be read two different ways.
#
# The monthly plan is a real subscription, and Payfast refuses to set one up
# on a merchant with no passphrase. Without it only the annual plan can be sold.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# true points checkout at sandbox.payfast.co.za instead of taking real money.
# On its own it uses Payfast's shared test merchant. Note that anyone can log
# into that account and change its passphrase, so signatures may be rejected
# there through no fault of this code — see docs/PAYMENTS.md.
PAYFAST_SANDBOX=

# The origin Payfast calls back on, e.g. https://pathwayexplore.com. Only
# needed if the forwarded headers from the host are wrong; normally leave empty.
PUBLIC_ORIGIN=

# ------------------------------------------------------------------- demo --
# Unlocks the four demo learners for one browser, via
#   /api/demo-access?key=<this>          and  ?key=off to lock it again.
# Unset in production means no demo accounts at all. Treat it as a password.
DEMO_ACCESS_KEY=
