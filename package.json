{
  "name": "pathway",
  "version": "1.0.0",
  "private": true,
  "description": "PATHWAY \u2014 Explore, Plan, Track, Build Your Future",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env lib/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env lib/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:api": "tsx scripts/test-api.ts",
    "dev:pg": "tsx scripts/pg-wire.ts",
    "test:payfast": "tsx scripts/test-payfast.ts",
    "test:payfast:flow": "tsx scripts/test-payfast-flow.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
